<resources>
    <style name="Theme.RTKPrivate" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rtk_green</item>
        <item name="colorPrimaryVariant">@color/rtk_green_dark</item>
        <item name="colorSecondary">@color/rtk_green</item>
        <item name="colorOnPrimary">@color/rtk_background</item>
        <item name="android:colorAccent">@color/rtk_green</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/rtk_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.RTK.Button</item>
    </style>

    <style name="Widget.RTK.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/rtk_green</item>
        <item name="android:textColor">@color/rtk_background</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
